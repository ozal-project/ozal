{
  "targets": {
    "edge-1": {
      "ssh": { "target": "deploy@edge.example.net", "key": "~/.ssh/id_ed25519" },
      "edge": {
        "unit": "switchboard",
        "service_user": "switchboard",
        "binary": "/usr/local/lib/switchboard/switchboard",
        "config": "/etc/switchboard/routing.json",
        "state_db": "/var/lib/switchboard/state.db",
        "stage": "/home/deploy/.local/share/switchboard-stage",
        "lock": "/home/deploy/.local/share/switchboard-deploy.lock",
        "command_link": "/usr/local/bin/switchboard",
        "keep": 3
      }
    }
  }
}
