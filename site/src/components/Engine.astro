---
import { APPS } from "../lib/engine";
const apps = Object.entries(APPS);
const people = [["none", "Not signed in"], ["ana", "Ana", "ana@acme.dev"], ["carla", "Carla", "carla@acme.dev"], ["bob", "Bob", "bob@other.org"]];
---
<section id="engine" aria-labelledby="engine-title" class="gap-above">
  <div class="frame">
    <h2 id="engine-title" class="heading" data-reveal>Ask the real engine.</h2>
    <p class="lead soft mt-5 max-w-[34ch]" data-reveal style="--i:1">
      The code that decides who gets in, running in your browser. Choose an app and a visitor, and read the answer.
    </p>
  </div>

  <div id="engine-demo" class="board frame mt-8" style="grid-auto-rows:auto">
    <!-- Without JavaScript, or before the engine loads: the same decision, recorded. -->
    <div data-fallback class="tile tile-2" style="grid-column:1/-1">
      <p class="small quiet">A recorded answer</p>
      <p class="lead mt-3"><span class="lamp lamp-no mr-3"></span>bob@other.org asks for grafana.acme.dev. Refused.</p>
      <p class="soft mt-3 max-w-[60ch]">Only addresses at acme.dev may open grafana.acme.dev; bob@other.org is not one of them.</p>
      <p class="small quiet mt-6" data-status>The live engine loads when this section comes into view and needs JavaScript.</p>
      <button type="button" data-start hidden class="button button-brand mt-4">Load the engine</button>
    </div>

    <div data-panel hidden class="board" style="grid-column:1/-1;grid-auto-rows:auto">
      <div class="tile" style="grid-column:1/span 5">
        <fieldset>
          <legend class="field-label">App</legend>
          <div class="grid gap-1.5">
            {apps.map(([key, app], i) => (
              <label class="opt">
                <input type="radio" name="app" value={key} checked={i === 0} />
                <span class="font-semibold">{app.host}</span>
                <small>{app.blurb}</small>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="mt-8">
          <legend class="field-label">Visitor</legend>
          <div class="grid grid-cols-2 gap-1.5">
            {people.map(([value, label, email], i) => (
              <label class="opt">
                <input type="radio" name="who" value={value} checked={i === 1} />
                <span class="font-semibold">{label}</span>
                {email && <small>{email}</small>}
              </label>
            ))}
          </div>
          <div class="mt-5 grid gap-3">
            <label class="flex items-center gap-3"><input type="checkbox" name="verified" checked class="size-5 accent-[var(--color-brand)]" />The sign-in provider confirmed the email</label>
            <label class="flex flex-wrap items-center gap-3">Signed in with
              <select name="method" class="flat"><option value="passkey">a passkey</option><option value="oidc">an identity provider</option></select>
            </label>
            <label class="flex items-center gap-3"><input type="checkbox" name="bound" class="size-5 accent-[var(--color-brand)]" />The passkey stays on one device</label>
          </div>
        </fieldset>
      </div>

      <div style="grid-column:6/span 7" class="engine-result grid gap-2 content-start">
        <div data-verdict data-state="allowed" class="tile verdict" aria-live="polite" aria-label="Decision">
          <p data-verdict-title class="heading">—</p>
          <p data-reason class="lead mt-4"></p>
          <p class="small soft mt-4">Decision code <span data-code class="font-semibold"></span></p>
          <ul data-stages class="mt-6"></ul>
        </div>
        <details class="tile tile-2"><summary class="cursor-pointer soft">The route as written in the config</summary><pre data-config class="code mt-4"></pre></details>
        <details class="tile tile-2"><summary class="cursor-pointer soft">The engine's full answer</summary><pre data-raw class="code mt-4"></pre></details>
        <p class="small quiet px-1" data-status></p>
      </div>
    </div>
  </div>

  <p class="small quiet frame mt-4 max-w-[70ch]">
    It answers one question: may this person open this app? Signing in, certificates, rate limits and the rest of the pipeline run on the edge and are not simulated here.
    The engine is <code class="soft">internal/auth</code> from this repository, compiled to WebAssembly.
  </p>
</section>

<script>
  import { setup } from "../scripts/engine";
  const root = document.getElementById("engine-demo");
  if (root) setup(root);
</script>
