---
// The live engine as an access matrix: every person against every app, each
// cell answered by engine.wasm (the edge's own decision code). Picking a cell
// shows how that answer was reached.
import { APPS } from "../lib/engine";
import Logo from "./Logo.astro";
const apps = Object.entries(APPS);
const rule: Record<string, string> = { grafana: "Company email", billing: "Ana, one-device passkey", wiki: "Recent company sign-in", blog: "Public" };
const people = [["none", "No session", "not signed in"], ["ana", "Ana", "ana@acme.dev"], ["carla", "Carla", "carla@acme.dev"], ["bob", "Bob", "bob@other.org"]];
const title = (key: string) => key.charAt(0).toUpperCase() + key.slice(1);
---
<section id="engine" aria-labelledby="engine-title" class="engine-stage window" data-ui>
  <span class="window-bar" aria-hidden="true"><i></i><i></i><i></i><b>Access decisions · running in your browser</b></span>
  <h3 id="engine-title" class="sr-only">Who can open what</h3>
  <div id="engine-demo" class="engine-body">
    <div data-fallback class="engine-fallback">
      <p class="label">Recorded example</p>
      <p class="decision-title">Refused</p>
      <p>Bob asks for grafana.acme.dev. Only people at acme.dev may open it; his email is bob@other.org.</p>
      <p class="small quiet" data-nojs>The interactive demo needs JavaScript. This recorded answer remains available.</p>
      <button type="button" data-start hidden class="button">Load the engine</button>
    </div>
    <div data-panel hidden class="engine-panel">
      <div class="engine-pick">
        <table class="matrix">
          <caption class="sr-only">The engine's answer for each person and app. Choose a cell to see how it was reached.</caption>
          <thead><tr><td></td>{apps.map(([key, app]) => <th scope="col"><span class="matrix-name">{title(key)}</span><small>{rule[key]}</small><span class="sr-only">{app.host}</span></th>)}</tr></thead>
          <tbody>{people.map(([who, name, email]) => (
            <tr>
              <th scope="row"><span class={`avatar avatar-${who}`} aria-hidden="true">{who === "none" ? "?" : name[0]}</span><span class="matrix-name">{name}</span><small>{email}</small></th>
              {apps.map(([key]) => <td><button type="button" class="cell" data-cell data-who={who} data-app={key} data-app-rule={rule[key]} aria-pressed="false"><i class="cell-mark" aria-hidden="true"></i><span class="cell-word">…</span></button></td>)}
            </tr>
          ))}</tbody>
        </table>
        <ul class="matrix-legend small quiet" aria-label="What the marks mean">
          <li><i class="cell-mark" data-state="allowed" aria-hidden="true"></i>Let in</li>
          <li><i class="cell-mark" data-state="again" aria-hidden="true"></i>Sign-in needed, or let in with a condition</li>
          <li><i class="cell-mark" data-state="refused" aria-hidden="true"></i>Refused</li>
        </ul>
        <details class="engine-settings"><summary>Change how people signed in</summary><div>
          <label><input type="checkbox" name="verified" checked />Email confirmed by the sign-in provider</label>
          <label>Signed in with<select name="method" class="flat"><option value="passkey">a passkey</option><option value="oidc">an identity provider</option></select></label>
          <label><input type="checkbox" name="bound" />The passkey stays on one device</label>
          <p class="quiet">These apply to everyone who is signed in. Watch which answers change.</p>
        </div></details>
      </div>
      <div class="engine-result">
        <div class="trace" data-trace data-state="allowed" aria-hidden="true">
          <span class="trace-end" data-trace-who>ana@acme.dev</span>
          <span class="trace-cord"><i></i></span>
          <span class="trace-hub"><Logo size={22} id="logo-engine" /></span>
          <span class="trace-cord trace-cord-out"><i></i></span>
          <span class="trace-end trace-app" data-trace-app>grafana.acme.dev</span>
        </div>
        <div data-verdict data-state="allowed" class="verdict" role="status" aria-live="polite" aria-atomic="true" aria-label="Decision">
          <p class="verdict-head"><span class="verdict-lamp" aria-hidden="true"></span><span data-verdict-title class="decision-title">—</span></p>
          <p data-reason class="verdict-reason"></p>
          <p data-rule class="verdict-rule"></p>
          <p class="verdict-code">code <code data-code></code></p>
        </div>
        <div class="decision-stages"><p class="stages-title">How this answer was reached</p><ol data-stages></ol></div>
        <details class="engine-technical"><summary>Show the policy and raw answer</summary><div><h4>Route config</h4><pre data-config class="code" tabindex="0"></pre><h4>Raw answer</h4><pre data-raw class="code" tabindex="0"></pre></div></details>
      </div>
    </div>
  </div>
  <p class="engine-foot"><span data-status class="engine-status"></span><span>Demo identities only. Sign-in, TLS and rate limits run on the server, not here.</span></p>
</section>
<script>
  import { setup } from "../scripts/engine";
  const root = document.getElementById("engine");
  if (root) setup(root);
</script>
