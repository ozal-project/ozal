---
import { APPS } from "../lib/engine";
const apps = Object.entries(APPS);
const people = [["none", "Not signed in"], ["ana", "Ana", "ana@acme.dev"], ["carla", "Carla", "carla@acme.dev"], ["bob", "Bob", "bob@other.org"]];
---
<section id="engine" aria-labelledby="engine-title" class="engine-stage" data-ui>
  <div class="engine-heading"><h2 id="engine-title">Try an access decision</h2><p>Choose an app and a person. Read the reason.</p></div>
  <div id="engine-demo">
    <div data-fallback class="engine-fallback">
      <p class="small quiet">Recorded example</p>
      <p class="decision-title">Refused</p>
      <p>Bob asks for grafana.acme.dev. Only people at acme.dev may open it; his email is bob@other.org.</p>
      <p class="small quiet" data-status>The interactive demo needs JavaScript. This recorded answer remains available.</p>
      <button type="button" data-start hidden class="button button-brand">Load the engine</button>
    </div>
    <div data-panel hidden class="engine-panel">
      <div class="engine-choices">
        <fieldset><legend>App</legend><div class="choice-grid">
          {apps.map(([key, app], i) => <label class="opt"><input type="radio" name="app" value={key} checked={i === 0} /><span>{key.charAt(0).toUpperCase() + key.slice(1)}</span><small>{key === "grafana" ? "Company email" : key === "billing" ? "Ana + device-bound passkey" : key === "wiki" ? "Recent company sign-in" : "Public access"}</small><span class="sr-only">{app.host}. {app.blurb}</span></label>)}
        </div></fieldset>
        <fieldset><legend>Person</legend><div class="choice-grid">
          {people.map(([value, label, email], i) => <label class="opt"><input type="radio" name="who" value={value} checked={i === 1} /><span>{label}</span><small>{email ?? "No session"}</small></label>)}
        </div></fieldset>
      </div>
      <details class="engine-settings"><summary>Sign-in details</summary><div>
        <label><input type="checkbox" name="verified" checked />Email confirmed by the sign-in provider</label>
        <label>Signed in with<select name="method" class="flat"><option value="passkey">a passkey</option><option value="oidc">an identity provider</option></select></label>
        <label><input type="checkbox" name="bound" />The passkey stays on one device</label>
      </div></details>
      <div data-verdict data-state="allowed" class="verdict" role="status" aria-live="polite" aria-atomic="true" aria-label="Decision">
        <p data-verdict-title class="decision-title">—</p>
        <p data-reason></p>
        <p class="small">Decision code: <code data-code></code></p>
        <details class="decision-stages"><summary>How this answer was reached</summary><ul data-stages></ul></details>
      </div>
      <details class="engine-technical"><summary>Policy and engine output</summary><div><h3>Route config</h3><pre data-config class="code"></pre><h3>Full engine answer</h3><pre data-raw class="code"></pre></div></details>
      <p class="engine-status small quiet" data-status></p>
    </div>
  </div>
  <p class="engine-scope">Real Go authorization code, compiled to WebAssembly. Demo identities only. Sign-in, TLS and rate limits run on the server and are outside this demo.</p>
</section>
<script>
  import { setup } from "../scripts/engine";
  const root = document.getElementById("engine-demo");
  if (root) setup(root);
</script>
