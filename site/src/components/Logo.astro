---
// Umbral: a doorway, and the light of the open door. Ivory arch, camel
// light, warm graphite leaf. Animated, the door opens.
const { size = 24, animated = false } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class:list={["logo", animated && "logo-live"]}>
  <path class="logo-arch" d="M5 30V14.5A11 11 0 0 1 27 14.5V30H21.6V14.8A5.6 5.6 0 0 0 10.4 14.8V30Z" fill="var(--color-brand)" />
  <path class="logo-leaf" d="M10.4 30V14.8A5.6 5.6 0 0 1 16 9.2V30Z" fill="var(--color-depth)" />
  <path class="logo-light" d="M16 9.2A5.6 5.6 0 0 1 21.6 14.8V30H16Z" fill="var(--color-signal)" />
</svg>
