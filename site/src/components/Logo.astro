---
// Two points joined by a line. Animated, the cord draws in and a signal runs it.
const { size = 24, animated = false } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 26 26" aria-hidden="true" class:list={["logo", animated && "logo-live"]}>
  <path class="logo-cord" d="M6 10.5 C6 19, 20 7, 20 15.5" stroke="var(--color-ink)" stroke-width="2" fill="none" stroke-linecap="round" pathLength="1" />
  <circle cx="6" cy="7" r="3.2" fill="var(--color-ink)" />
  <circle class="logo-to" cx="20" cy="19" r="3.2" fill="var(--color-brand)" />
  {animated && <circle class="logo-signal" r="1.4" fill="var(--color-brand)" />}
</svg>
