---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="Page not found · Ozal"
  description="No page exists at this address. Start from the home page or the documentation."
  path="/404.html"
  noindex
>
  <Header />
  <main id="main-content" tabindex="-1" class="not-found frame">
    <p class="label">404</p>
    <h1>No door at this address.</h1>
    <p class="not-found-copy">The page you asked for does not exist. It may have moved, or the address may be wrong.</p>
    <div class="not-found-actions">
      <a class="button" href="/">Go home</a>
      <a class="text-link" href="/docs/">Read the documentation</a>
      <a class="text-link" href="https://github.com/ozal-project/ozal">Source on GitHub</a>
    </div>
  </main>
  <Footer />
</Base>
