---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { ARTICLES } from "../../lib/articles.mjs";
import { GUIDES } from "../../lib/guides.mjs";

const docs = GUIDES.map((guide) => ({
  href: guide.slug ? `/docs/${guide.slug}/` : "/docs/",
  label: guide.nav,
}));
---
<Base
  title="All pages · Ozal"
  description="Every page on ozal.dev, for people. Search engines read the XML sitemap."
  noindex
>
  <Header />
  <main id="main-content" tabindex="-1" class="article frame">
    <article class="prose">
      <nav class="docs-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">All pages</li>
        </ol>
      </nav>
      <h1>All pages</h1>
      <p class="article-meta">Every page on ozal.dev, for people. Search engines read the <a href="/sitemap.xml">XML sitemap</a>.</p>

      <h2>Product</h2>
      <ul>
        <li><a href="/">Home</a></li>
        {ARTICLES.map((article) => (
          <li><a href={article.path}>{article.nav}</a></li>
        ))}
      </ul>

      <h2>Documentation</h2>
      <ul>
        {docs.map((guide) => (
          <li><a href={guide.href}>{guide.label}</a></li>
        ))}
      </ul>

      <h2>Machine-readable</h2>
      <ul>
        <li><a href="/sitemap.xml">XML sitemap</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </article>
  </main>
  <Footer />
</Base>
