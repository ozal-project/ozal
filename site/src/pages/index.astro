---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Engine from "../components/Engine.astro";
import { PLAIN } from "../lib/plain";
import { rows } from "../lib/board";
import sample from "../data/access-sample.json";
import { closures, doneIds, openTasks, tracks, type State } from "../lib/tracker";
import todo from "../../../docs/TO_IMPLEMENT.md?raw";
import implemented from "../../../docs/IMPLEMENTED.md?raw";

const repo = "https://github.com/octaviosantacruz/switchboard";
const release = `${repo}/releases/tag/v0.1.0-alpha.1`;
// Keep repository links hidden while GitHub reports the repository as private.
const sourcePublic = false;

// Roadmap and changelog come from docs/TO_IMPLEMENT.md and docs/IMPLEMENTED.md.
const open = openTasks(todo);
const done = doneIds(open, implemented);
const byTrack = tracks(open, done);
const log = closures(implemented);
const count = (s: State) => open.filter((t) => t.state === s).length;
const stats = [
  { n: done.size, label: "tasks done" },
  { n: count("progress"), label: "in progress" },
  { n: count("planned") + count("ready"), label: "planned" },
];
const lamp: Record<State, string> = { progress: "lamp-wait", ready: "lamp-brand", blocked: "lamp-no", planned: "", idea: "" };
const word: Record<State, string> = { progress: "in progress", ready: "ready", blocked: "blocked", planned: "planned", idea: "idea" };
const name = (t: { id: string; title: string }) => PLAIN[t.id] ?? t.title;
const day = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const board = rows(sample);

const works = [
  { t: "Routing by hostname", d: "Routes HTTP services by hostname, with health checks and one config for localhost or a real domain.", e: "Automated tests · Linux edge dogfooding" },
  { t: "Automatic HTTPS", d: "ACME TLS-ALPN-01 or Cloudflare DNS-01, with a single-level wildcard and background renewal.", e: "A production certificate on the author's server · the DNS adapter is Cloudflare-specific" },
  { t: "Login per route", d: "Signs people in with a passkey or an external OIDC provider, then checks their verified email and its domain.", e: "Automated tests · passkeys are on main, not in alpha.1" },
  { t: "Explainable decisions", d: "The same decision, with a stable code and a reason, in the CLI, the console and this page.", e: "Automated tests" },
  { t: "Static sites", d: "Immutable builds, a switch for the live one, rollback, and deploys from GitHub Actions with no stored secret.", e: "Observed on the author's server · single host" },
  { t: "A console for operators", d: "What needs attention, what changed and who got in, in plain words. Loopback-only: never expose it publicly.", e: "On main · recorded demo workspace" },
  { t: "Secrets by reference", d: "env: and file: references resolved at runtime; nothing resolved is written back.", e: "Automated tests · one binary, optional embedded SQLite" },
];

const pipeline = [
  { s: "trust", d: "Who is really asking: client IP, trusted proxies, origin certificate.", state: "built" },
  { s: "ratelimit", d: "Per visitor and per app limits.", state: "building" },
  { s: "shield", d: "Rules and challenges for suspicious traffic.", state: "planned" },
  { s: "identify", d: "Passkeys, or your OIDC provider.", state: "built" },
  { s: "authorize", d: "One pure decision with a code and a reason.", state: "built" },
  { s: "route", d: "Host lookup in an atomic snapshot.", state: "built" },
  { s: "forward", d: "HTTP upstream or a static site. Tunnels are experimental.", state: "built" },
] as const;
const stateWord = { built: "Built", building: "In progress", planned: "Planned" } as const;

const trains = [
  { v: "v0.1", n: "Edge", when: "Oct – Dec 2026", now: true, line: "Routing, certificates, passkeys, sites." },
  { v: "v0.2", n: "PKI", when: "Jan – Mar 2027", now: false, line: "A private CA and mTLS between parts." },
  { v: "v0.3", n: "Access", when: "Apr – Jun 2027", now: false, line: "SSH and databases, approvals, a WAF." },
  { v: "v0.4", n: "Trust", when: "Jul – Sep 2027", now: false, line: "A transparency log and an AI-agent gateway." },
];

const chapters = [
  ["The operator opens the console", "One thing needs attention: an app that does not answer."],
  ["Inviting Ana", "A one-time link. No password to share."],
  ["Ana creates a passkey", "On her own device, in one tap."],
  ["Her page lists only her apps", "Grafana, Billing, the wiki. Nothing else."],
  ["Bob, from another company", "His page is empty. Grafana says no, says why, and offers a way back."],
  ["Back in the console", "Who got in, and why Bob was refused."],
];
---
<Base title="Switchboard — your apps, your access rules" description="Control who can open your apps, with a reason for every decision. A self-hosted access gateway in one Go binary. Try the real policy engine in your browser.">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="topbar frame">
    <a href="/" class="mark" aria-label="Switchboard home"><Logo size={28} /><span>switchboard</span></a>
    <nav aria-label="Sections">
      <a href="#views">Product</a>
      <a href="#tour">Tour</a>
      <a href="#roadmap">Roadmap</a>
      <a href="#start">Availability</a>
    </nav>
    <a class="button button-brand header-action" href="#engine">Try the demo</a>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="hero frame" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Your apps.<br />Your access rules.</h1>
        <p class="hero-description">Control who can open your apps, with a reason for every decision. Self-hosted in one Go binary.</p>
        <div class="hero-actions">
          <a class="button button-brand" href="#engine">Try an access decision <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#tour">Watch the product tour <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note">Early alpha. Running on the author's server.<br />The demo uses the same Go policy code as the gateway.</p>
      </div>
      <Engine />
    </section>

    <section id="views" class="section frame" aria-labelledby="views-title">
      <div class="section-intro">
        <h2 id="views-title">See who gets in.</h2>
        <p>People open their apps. Operators manage access. Developers can trace the decision. These are real screens from a recorded demo workspace.</p>
      </div>
      <div class="product-views">
        <fieldset class="view-picker">
          <legend class="sr-only">Choose a product view</legend>
          <label><input type="radio" id="view-operator" name="product-view" checked /><span>For operators</span></label>
          <label><input type="radio" id="view-person" name="product-view" /><span>For app users</span></label>
          <label><input type="radio" id="view-developer" name="product-view" /><span>For developers</span></label>
        </fieldset>
        <div class="product-panel operator-view">
          <div class="product-copy">
            <h3>What needs you,<br /> and what changed.</h3>
            <p>See the app that stopped answering, recent deployments, and who was allowed or refused. Invite people and manage their passkeys from the same console.</p>
            <p class="small quiet">The operator console stays on loopback. Screenshots use demo data.</p>
          </div>
          <figure class="product-shot"><a href="/shots/overview.jpg" aria-label="Open the full-size operator console screenshot"><img src="/shots/overview.jpg" width="2560" height="1600" loading="lazy" alt="Switchboard Overview with an app needing attention, recent changes and access decisions." /></a><figcaption>Operator console · Overview. Open the image to see it full size.</figcaption></figure>
        </div>
        <div class="product-panel person-view">
          <div class="product-copy">
            <h3>Your apps.<br /> A clear way back.</h3>
            <p>A signed-in person sees only the apps their policy allows. A refusal explains the reason and offers a way back to their apps.</p>
            <p class="small quiet">Passkeys and the portal are on main; they are not included in the alpha.1 archive.</p>
          </div>
          <div class="visitor-shots">
            <figure class="product-shot"><img src="/shots/portal.jpg" width="840" height="702" loading="lazy" alt="Ana's portal lists the apps her account may open." /><figcaption>Ana's apps</figcaption></figure>
            <figure class="product-shot"><img src="/shots/refused.jpg" width="840" height="702" loading="lazy" alt="Bob's refusal page names the reason and links back to his apps." /><figcaption>Bob's refusal</figcaption></figure>
          </div>
        </div>
        <div class="product-panel developer-view">
          <div class="product-copy">
            <h3>One decision.<br /> An answer you can trace.</h3>
            <p>Ask the policy engine about a person and a route. Read the stable decision code and its reason in the CLI, the console or the live demo above.</p>
            <p><a class="text-link" href="#architecture">See the request pipeline <span aria-hidden="true">↓</span></a></p>
          </div>
          <div class="terminal" data-ui><pre><code>$ switchboard policy explain \
    -host grafana.acme.dev \
    -email bob@other.org -verified

route     grafana.acme.dev (protected)
policy    allowed_domains=[acme.dev]
decision  denied
code      domain_not_allowed
reason    account's email domain
          is not on the allowed list</code></pre><p class="small quiet">An example policy and identity, evaluated by Switchboard.</p></div>
        </div>
      </div>
    </section>

    <section id="tour" class="section frame" aria-labelledby="tour-title">
      <div class="section-intro">
        <h2 id="tour-title">Watch it work.</h2>
        <p>From an invitation to a passkey, an allowed visit and a refusal. Recorded on a real edge with demo accounts; only the captions are added.</p>
      </div>
      <div class="tour-layout">
        <figure class="tour-video">
          <video controls preload="none" poster="/shots/overview.jpg" width="1280" height="800" aria-label="Switchboard product tour with captions">
            <source src="/tour/tour.webm" type="video/webm" />
            Your browser cannot play this video. Read the same walk-through beside it.
          </video>
          <figcaption>A real console and sign-in flow, recorded with demo data.</figcaption>
        </figure>
        <div class="tour-chapters"><h3>The walkthrough</h3><ol>{chapters.map(([t, d]) => <li><strong>{t}</strong><p>{d}</p></li>)}</ol></div>
      </div>
      <details class="disclosure tour-log">
        <summary>Read the access decisions from this tour</summary>
        <div class="disclosure-body">
          <p class="quiet small">Recorded demo data. Open a row for the reason.</p>
          <div class="rows" data-ui>{board.map((r) => (
            <details class="row" name="log">
              <summary><span class="request-person">{r.who}<small>{r.app}</small></span><span class={`status ${r.ok ? "status-ok" : "status-no"}`}>{r.status}</span></summary>
              <p class="detail">{r.detail}</p>
            </details>
          ))}</div>
        </div>
      </details>
    </section>

    <section id="today" class="section frame" aria-labelledby="today-title">
      <div class="section-intro"><h2 id="today-title">What works today.</h2><p>Automated tests and limited use by one operator. The evidence and release boundaries are stated with each capability.</p></div>
      <div class="capabilities">{works.map((w) => (
        <article><h3>{w.t}</h3><p>{w.d}</p><p class="small quiet">{w.e}</p></article>
      ))}</div>
      <p class="scope-note"><strong>Still experimental.</strong> Outbound tunnels, rate limiting and Telegram alerts exist in the code and sit outside the alpha's promise. Account recovery requires the operator's local CLI.</p>
      <details id="architecture" class="disclosure">
        <summary>How a request moves through Switchboard</summary>
        <div class="disclosure-body"><p class="quiet">The request pipeline keeps its checks in one order. Each stage below states its implementation status.</p><ol class="pipeline">{pipeline.map((p) => <li><div><strong>{p.s}</strong><span class={`small pipeline-state ${p.state}`}>{stateWord[p.state]}</span></div><p>{p.d}</p></li>)}</ol></div>
      </details>
    </section>

    <section id="roadmap" class="section frame" aria-labelledby="roadmap-title">
      <div class="section-intro"><h2 id="roadmap-title">Where it goes next.</h2><p>A year-long project, October 2026 to September 2027. Progress below is read from the project's trackers at build time. Partial work stays open.</p></div>
      <dl class="progress-counts">{stats.map((s) => <div><dt>{s.label}</dt><dd>{s.n}</dd></div>)}</dl>
      <ol class="release-plan">{trains.map((t) => <li class={t.now ? "current" : ""}><h3>{t.v} · {t.n}</h3><p class="small quiet">{t.now ? "Current · " : "Planned · "}{t.when}</p><p>{t.line}</p></li>)}</ol>
      <p class="roadmap-note">The long-range goal includes a verifiable transparency log. Future releases are direction; they are not capabilities of today's alpha.</p>
      <div class="bars">{byTrack.map((t) => (
        <details name="track"><summary><span>{t.name}</span><span class="track-count small quiet">{t.closed} done · {t.open.length} open</span></summary><div><p class="soft">{t.blurb}</p><ul>{t.open.map((x) => <li><span class={`lamp ${lamp[x.state]}`} aria-hidden="true"></span><span>{name(x)}<small class="quiet">{word[x.state]}</small></span></li>)}</ul></div></details>
      ))}
        <details name="track"><summary><span>Recently shipped</span><span class="track-count small quiet">{log.length} changelog entries</span></summary><div><p class="soft">The latest entries from the implementation log.</p><ul>{log.slice(0, 14).map((c) => <li><span class="lamp lamp-ok" aria-hidden="true"></span><span>{c.title}<small class="quiet">{day(c.date)}</small></span></li>)}</ul></div></details>
      </div>
    </section>

    <section id="start" class="availability frame section" aria-labelledby="start-title">
      <div><h2 id="start-title">Explore the alpha.</h2><p>{sourcePublic ? "Downloads for Linux, macOS and Windows, with a quickstart to route your first app." : "The repository and alpha downloads are currently private. You can try the policy engine here, watch the product tour or visit the maintainer's site to get in touch."}</p></div>
      <div class="availability-actions">{sourcePublic ? <a class="button button-brand" href={release}>Download alpha.1 <span aria-hidden="true">↗</span></a> : <a class="button button-brand" href="https://octaviosantacruz.com">Visit the maintainer's site <span aria-hidden="true">↗</span></a>}<a class="text-link" href="#engine">Back to the live demo ↑</a></div>
    </section>
  </main>
  <footer class="footer frame"><a class="mark" href="#main-content"><Logo size={26} /><span>switchboard</span></a><p>Built by <a href="https://octaviosantacruz.com">Octavio Santacruz</a>. MIT licensed.<br />{sourcePublic ? <a href={repo}>Source on GitHub</a> : "Source is private while the alpha settles."}</p><a href="#main-content" class="text-link">Back to top ↑</a></footer>
</Base>
<script>import "../scripts/page";</script>
