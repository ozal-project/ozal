---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Engine from "../components/Engine.astro";
import { PLAIN } from "../lib/plain";
import { rows } from "../lib/board";
import sample from "../data/access-sample.json";
import { closures, doneIds, openTasks, tracks, type State } from "../lib/tracker";
import todo from "../../../docs/TO_IMPLEMENT.md?raw";
import implemented from "../../../docs/IMPLEMENTED.md?raw";

const repo = "https://github.com/octaviosantacruz/switchboard";
const release = `${repo}/releases/tag/v0.1.0-alpha.1`;
// Keep repository links hidden while GitHub reports the repository as private.
const sourcePublic = false;

// Roadmap and changelog come from docs/TO_IMPLEMENT.md and docs/IMPLEMENTED.md.
const open = openTasks(todo);
const done = doneIds(open, implemented);
const byTrack = tracks(open, done);
const log = closures(implemented);
const count = (s: State) => open.filter((t) => t.state === s).length;
const stats = [
  { n: done.size, label: "tasks done" },
  { n: count("progress"), label: "in progress" },
  { n: count("planned") + count("ready"), label: "planned" },
  { n: log.length, label: "entries in the changelog" },
];
const lamp: Record<State, string> = { progress: "lamp-wait", ready: "lamp-brand", blocked: "lamp-no", planned: "", idea: "" };
const word: Record<State, string> = { progress: "in progress", ready: "ready", blocked: "blocked", planned: "planned", idea: "idea" };
const name = (t: { id: string; title: string }) => PLAIN[t.id] ?? t.title;
const day = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const board = rows(sample);
const firstOpen = board.findIndex((r) => !r.ok);

const works = [
  { t: "Names, not ports", d: "Routes HTTP services by hostname, with health checks and one config for localhost or a real domain.", e: "Automated tests · Linux edge dogfooding", w: 6 },
  { t: "Automatic HTTPS", d: "ACME TLS-ALPN-01 or Cloudflare DNS-01, with a single-level wildcard and background renewal.", e: "A production certificate on the author's server · the DNS adapter is Cloudflare-specific", w: 6 },
  { t: "Login per route", d: "Signs people in with a passkey or an external OIDC provider, then checks their verified email and its domain.", e: "Automated tests · passkeys are on main, not in alpha.1", w: 4 },
  { t: "Explainable decisions", d: "The same decision, with a stable code and a reason, in the CLI, the console and this page.", e: "Automated tests", w: 4 },
  { t: "Static sites", d: "Immutable builds, a switch for the live one, rollback, and deploys from GitHub Actions with no stored secret.", e: "Observed on the author's server · single host", w: 4 },
  { t: "A console for operators", d: "What needs attention, what changed and who got in, in plain words. Loopback-only: never expose it publicly.", e: "On main since this week", w: 6 },
  { t: "Secrets by reference", d: "env: and file: references resolved at runtime; nothing resolved is written back.", e: "Automated tests · one binary, optional embedded SQLite", w: 6 },
];

const pipeline = [
  { s: "trust", d: "Who is really asking: client IP, trusted proxies, origin certificate.", state: "built" },
  { s: "ratelimit", d: "Per visitor and per app limits.", state: "building" },
  { s: "shield", d: "Rules and challenges for suspicious traffic.", state: "planned" },
  { s: "identify", d: "Passkeys, or your OIDC provider.", state: "built" },
  { s: "authorize", d: "One pure decision with a code and a reason.", state: "built" },
  { s: "route", d: "Host lookup in an atomic snapshot.", state: "built" },
  { s: "forward", d: "HTTP upstream or a static site. Tunnels are experimental.", state: "built" },
] as const;
const stateWord = { built: "Built", building: "In progress", planned: "Planned" } as const;

const trains = [
  { v: "v0.1", n: "Edge", when: "Oct – Dec 2026", now: true, line: "Routing, certificates, passkeys, sites." },
  { v: "v0.2", n: "PKI", when: "Jan – Mar 2027", now: false, line: "A private CA and mTLS between parts." },
  { v: "v0.3", n: "Access", when: "Apr – Jun 2027", now: false, line: "SSH and databases, approvals, a WAF." },
  { v: "v0.4", n: "Trust", when: "Jul – Sep 2027", now: false, line: "A transparency log and an AI-agent gateway." },
];

const chapters = [
  ["The operator opens the console", "One thing needs attention: an app that does not answer."],
  ["Inviting Ana", "A one-time link. No password to share."],
  ["Ana creates a passkey", "On her own device, in one tap."],
  ["Her page lists only her apps", "Grafana, Billing, the wiki. Nothing else."],
  ["Bob, from another company", "His page is empty. Grafana says no, says why, and offers a way back."],
  ["Back in the console", "Who got in, and why Bob was refused."],
];
---
<Base title="Switchboard — who gets in to your apps, and why" description="A self-hostable gateway in one Go binary. Every request gets a yes or a no with a reason anyone can read: login with passkeys, certificates, static-site deploys from CI, and a console that says what happened.">
  <a class="sr-only focus:not-sr-only" style="position:fixed;top:8px;left:8px;z-index:50;background:var(--color-ink);color:var(--color-bg);padding:8px 14px;border-radius:var(--radius)" href="#main-content">Skip to content</a>

  <header class="topbar">
    <a href="/" class="mark" aria-label="Switchboard home"><Logo size={26} /></a>
    <nav aria-label="Sections">
      <a class="link-quiet" href="#views">Product</a>
      <a class="link-quiet" href="#engine">Try it</a>
      <a class="link-quiet" href="#tour">Tour</a>
      <a class="link-quiet" href="#roadmap">Roadmap</a>
      <a class="link-quiet" href="#start">Get started</a>
    </nav>
    <div class="act"><a class="button button-brand" href="#engine">Try the engine</a></div>
  </header>

  <main id="main-content" tabindex="-1">
    <!-- The first screen: a two-by-two board. -->
    <section class="board frame mt-2" aria-label="Switchboard" style="grid-template-rows:minmax(300px,1fr) minmax(300px,1fr);min-height:calc(100svh - 84px)">
      <div class="tile tile-2 flex items-end" style="grid-column:1/span 6">
        <h1 class="name" data-reveal>switchboard<span class="sr-only"> — a self-hosted gateway that decides who gets in</span></h1>
      </div>
      <figure class="tile tile-pic shutter" style="grid-column:7/span 6">
        <img src="/shots/overview.jpg" width="2560" height="1600" fetchpriority="high" alt="The Switchboard console's overview: one app is not answering, recent deploys and who got in." />
      </figure>
      <figure class="tile tile-pic" style="grid-column:1/span 6">
        <video data-loop autoplay muted loop playsinline preload="metadata" poster="/shots/people.jpg" width="1280" height="800" aria-label="A short loop of the console in use: an invitation is created and the changes list updates.">
          <source src="/tour/loop.webm" type="video/webm" />
        </video>
      </figure>
      <div class="tile" style="grid-column:7/span 3">
        <p class="lead" data-reveal>A self-hosted gateway that decides who gets in, and tells you why.</p>
      </div>
      <div class="tile tile-brand" style="grid-column:10/span 3">
        <p class="lead" data-reveal style="--i:1">One Go binary on your own server.</p>
        <p class="mt-3">Running octaviosantacruz.com since 21 October.</p>
      </div>
    </section>

    <!-- One request, three views: the same refusal as each person sees it. -->
    <section id="views" aria-labelledby="views-title" class="board frame gap-above" style="grid-auto-rows:96px">
      <div class="tile tile-bare" style="grid-column:1/span 6;grid-row:1/span 2">
        <h2 id="views-title" class="heading" data-reveal>One request, three views.</h2>
      </div>
      <div class="tile tile-2" style="grid-column:7/span 6;grid-row:1/span 2;--i:1" data-reveal>
        <p class="lead">The person at the door sees only what is theirs, and a clear answer when something is not.</p>
      </div>
      <figure class="tile tile-pic" style="grid-column:1/span 4;grid-row:3/span 4" data-reveal>
        <img src="/shots/portal.jpg" width="840" height="702" loading="lazy" alt="Ana's page: the apps she may open, and a note on the one that may ask her to sign in again." />
      </figure>
      <div class="tile tile-3" style="grid-column:5/span 4;grid-row:3/span 4" data-reveal>
        <p class="lead">The developer gets the same decision in a terminal.</p>
        <pre class="code mt-5"><code>$ switchboard policy explain \
    -host grafana.acme.dev \
    -email bob@other.org -verified
route     grafana.acme.dev (protected)
policy    allowed_domains=[acme.dev]
decision  denied
code      domain_not_allowed
reason    account's email domain
          is not on the allowed list</code></pre>
      </div>
      <figure class="tile tile-pic" style="grid-column:9/span 4;grid-row:3/span 4" data-reveal>
        <img src="/shots/refused.jpg" width="840" height="702" loading="lazy" alt="What Bob sees when he opens an app he may not: who he is signed in as, why, a button back to his apps, and a reference." />
      </figure>
      <figure class="tile tile-pic" style="grid-column:1/span 8;grid-row:7/span 5" data-reveal>
        <img src="/shots/people.jpg" width="2560" height="1600" loading="lazy" alt="The console's People page: invitations waiting to be used and passkeys already created." />
      </figure>
      <div class="tile tile-brand" style="grid-column:9/span 4;grid-row:7/span 5" data-reveal>
        <p class="lead">The operator sees what happened, and why.</p>
        <p class="mt-4">Deploys, new passkeys, refusals, and the app that stopped answering, in plain words.</p>
      </div>
    </section>

    <Engine />

    <!-- The recorded tour. -->
    <section id="tour" aria-labelledby="tour-title" class="gap-above">
      <div class="frame">
        <h2 id="tour-title" class="heading" data-reveal>Watch it end to end.</h2>
        <p class="lead soft mt-5 max-w-[36ch]" data-reveal style="--i:1">Recorded on a real edge with demo data. The invitation, the passkeys and the refusal are all real; only the captions are added.</p>
      </div>
      <div class="board frame mt-8" style="grid-auto-rows:auto">
        <figure class="tile tile-pic" style="grid-column:1/span 8;aspect-ratio:16/10" data-reveal>
          <video controls preload="none" poster="/shots/overview.jpg" width="1280" height="800" style="object-fit:contain;background:#000">
            <source src="/tour/tour.webm" type="video/webm" />
            Your browser cannot play this video. The same walk-through is written out below.
          </video>
        </figure>
        <div class="tile tile-2" style="grid-column:9/span 4;--i:1" data-reveal>
          <h3 class="lead">In six scenes</h3>
          <ol class="mt-4 grid gap-4 list-decimal pl-5">
            {chapters.map(([t, d]) => <li><span class="font-semibold">{t}.</span> <span class="soft">{d}</span></li>)}
          </ol>
        </div>
      </div>
    </section>

    <!-- The access log as a departure board: real decisions from that tour. -->
    <section id="log" aria-labelledby="log-title" class="gap-above">
      <div class="frame">
        <h2 id="log-title" class="heading" data-reveal>Every decision, explained.</h2>
        <p class="lead soft mt-5 max-w-[40ch]" data-reveal style="--i:1">The access log of that tour. Open a row to read why.</p>
      </div>
      <div class="rows frame mt-8" data-ui>
        {board.map((r, i) => (
          <details class="row" name="log" open={i === firstOpen} data-reveal style={`--i:${Math.min(i, 5)}`}>
            <summary>
              <span class="font-semibold">{r.who}</span>
              <span class="dropped soft">{r.app}</span>
              <span class="dropped soft tnum">{r.reason}</span>
              <span class={`status ${r.ok ? "status-ok" : "status-no"}`}>{r.status}</span>
            </summary>
            <p class="detail">{r.detail}</p>
          </details>
        ))}
      </div>
      <p class="small quiet frame mt-3">Demo data from a demo edge. Times are UTC.</p>
    </section>

    <!-- The pipeline as one bar. -->
    <section id="how" aria-labelledby="how-title" class="gap-above">
      <div class="frame">
        <h2 id="how-title" class="heading" data-reveal>One pipeline, in order.</h2>
        <p class="lead soft mt-5 max-w-[44ch]" data-reveal style="--i:1">Every request walks the same stages, in one place. Each decision is a pure function that returns a code and a reason, so the proxy, the CLI and the console never disagree.</p>
      </div>
      <ol class="bar frame mt-10">
        {pipeline.map((p, i) => (
          <li class={p.state} style={`--i:${i}`}>
            <span class="lead font-semibold">{p.s}</span>
            <span class="small">{stateWord[p.state]}</span>
          </li>
        ))}
      </ol>
      <ul class="frame mt-3 grid gap-3 md:grid-cols-7">
        {pipeline.map((p) => <li class="small soft list-none">{p.d}</li>)}
      </ul>
    </section>

    <!-- What works: a mosaic of unlike tiles. -->
    <section id="today" aria-labelledby="today-title" class="gap-above">
      <div class="frame">
        <h2 id="today-title" class="heading" data-reveal>What works today.</h2>
        <p class="lead soft mt-5 max-w-[40ch]" data-reveal style="--i:1">The alpha has automated tests and limited dogfooding by one operator. Each tile says where it has run, and where it has not.</p>
      </div>
      <div class="board frame mt-8" style="grid-auto-rows:auto">
        {works.map((w, i) => (
          <div class={`tile ${["tile-2", "tile", "tile-3", "tile-2", "tile", "tile-brand", "tile-2"][i]}`} style={`grid-column:span ${w.w};min-height:200px`} data-reveal>
            <h3 class="lead font-semibold">{w.t}</h3>
            <p class="mt-3">{w.d}</p>
            <p class="small mt-4" style="opacity:.78">{w.e}</p>
          </div>
        ))}
        <div class="tile tile-bare" style="grid-column:1/-1;padding:24px 0 0">
          <p class="soft max-w-[70ch]"><span class="font-semibold text-ink">The boundaries.</span> Account recovery is a host CLI operation over a local admin socket; the HTTP API refuses it. Outbound tunnels, rate limiting and Telegram alerts exist in the code but are experimental and outside the alpha's promise.</p>
        </div>
      </div>
    </section>

    <!-- Proof: the numbers, read from the project's own trackers. -->
    <section aria-labelledby="proof-title" class="gap-above">
      <div class="frame">
        <h2 id="proof-title" class="heading" data-reveal>Built in the open.</h2>
      </div>
      <div class="board frame mt-8" style="grid-auto-rows:auto">
        <div class="tile tile-brand" style="grid-column:span 6">
          <p class="lead">Read from the project's trackers every time this page is built, so it cannot drift.</p>
        </div>
        {stats.map((s, i) => (
          <p class={`tile ${i % 2 ? "tile-3" : "tile-2"}`} style="grid-column:span 2;min-height:200px;display:flex;flex-wrap:wrap;align-content:space-between;align-items:baseline;gap:4px 16px" data-reveal>
            <span class="sr-only">{s.n}</span>
            <span class="heading tnum" aria-hidden="true" data-count>{s.n}</span>
            <span class="soft">{s.label}</span>
          </p>
        ))}
      </div>
    </section>

    <!-- The roadmap: one giant word, then bars. -->
    <section id="roadmap" aria-labelledby="roadmap-title" class="gap-above">
      <div class="frame">
        <h2 id="roadmap-title" class="name" data-reveal>Roadmap</h2>
      </div>
      <div class="board frame mt-8" style="grid-auto-rows:auto">
        <div class="tile tile-bare" style="grid-column:1/span 5;padding:0" data-reveal>
          <p class="lead">Each line is a task with an ID, done criteria and evidence in the tracker.</p>
          <p class="soft mt-4">The long-range goal is a transparency log anyone can check. That is a direction, not a claim: each release promises only what its tests and its deployments show.</p>
        </div>
        <ol class="board" style="grid-column:6/span 7;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:auto">
          {trains.map((t) => (
            <li class={`tile ${t.now ? "tile-brand" : "tile-2"} list-none`} data-reveal>
              <p class="lead font-semibold">{t.v} · {t.n}</p>
              <p class="small mt-1" style="opacity:.85">{t.now ? "Now · " : ""}{t.when}</p>
              <p class="mt-3">{t.line}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="bars frame mt-3">
        {byTrack.map((t, i) => (
          <details name="track" open={i === 0} data-reveal style={`--i:${Math.min(i, 5)}`}>
            <summary><span>{t.name} <span class="quiet small ml-2">{t.closed} done · {t.open.length} open</span></span></summary>
            <div>
              <p class="soft small">{t.blurb}</p>
              <ul class="grid gap-2">
                {t.open.map((x) => (
                  <li><span class={`lamp ${lamp[x.state]}`} title={word[x.state]}></span><span class="soft">{name(x)}<span class="sr-only"> ({word[x.state]})</span></span></li>
                ))}
              </ul>
            </div>
          </details>
        ))}
        <details name="track" data-reveal>
          <summary><span>Shipped, newest first <span class="quiet small ml-2">{log.length} entries</span></span></summary>
          <div>
            <ul class="grid gap-2">
              {log.slice(0, 14).map((c) => (
                <li><span class="lamp lamp-ok"></span><span class="soft"><span class="quiet small mr-2">{day(c.date)}</span>{c.title}</span></li>
              ))}
            </ul>
          </div>
        </details>
      </div>
      <p class="small quiet frame mt-3 max-w-[70ch]"><span class="lamp lamp-wait mr-2"></span>in progress <span class="lamp lamp-brand mx-2 ml-4"></span>ready <span class="lamp lamp-no mx-2 ml-4"></span>blocked <span class="lamp mx-2 ml-4"></span>planned or an idea</p>
    </section>

    <!-- The close: the action is one tile of the board. -->
    <section id="start" aria-labelledby="start-title" class="board frame gap-above" style="grid-auto-rows:auto">
      <figure class="tile tile-pic hidden md:block" style="grid-column:1/span 2;min-height:360px">
        <img src="/shots/access-log.jpg" width="2560" height="1600" loading="lazy" alt="" />
      </figure>
      <div class="tile tile-brand" style="grid-column:3/span 8;min-height:360px;padding:40px" data-reveal>
        <h2 id="start-title" class="heading">Try the alpha.</h2>
        <p class="lead mt-4 max-w-[34ch]">Linux, macOS and Windows archives, and a quickstart. The repository is private for now, so you need GitHub access to download it.</p>
        <p class="mt-6"><a class="button" style="background:var(--color-brand-ink);color:var(--color-ink)" href={release}>Open v0.1.0-alpha.1 <span aria-hidden="true">↗</span></a></p>
      </div>
      <div class="tile tile-3 hidden md:block" style="grid-column:11/span 2;min-height:360px"></div>
    </section>
  </main>

  <footer class="frame gap-above">
    <div class="board" style="grid-auto-rows:auto">
      <div class="tile tile-2 flex items-center gap-6" style="grid-column:1/span 12;min-height:34svh;overflow:hidden">
        <Logo size={200} />
        <p class="name" aria-hidden="true">switchboard</p>
      </div>
      <p class="small quiet tile tile-bare" style="grid-column:1/span 8;padding:8px 0">Built in public by <a class="soft underline" href="https://octaviosantacruz.com">Octavio Santacruz</a>, a year-long project, October 2026 to September 2027. MIT licensed. {sourcePublic ? <a class="soft underline" href={repo}>Source on GitHub.</a> : "Source: private while the alpha settles."}</p>
      <p class="small quiet tile tile-bare" style="grid-column:9/span 4;padding:8px 0;text-align:right"><a class="soft underline" href="#main-content">Back to the top</a></p>
    </div>
  </footer>
</Base>

<script>
  import "../scripts/page";
</script>
