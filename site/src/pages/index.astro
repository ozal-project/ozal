---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { trains } from "../data/trains";
import Engine from "../components/Engine.astro";
import EdgeMap from "../components/EdgeMap.astro";
import { rows } from "../lib/board";
import sample from "../data/access-sample.json";
import { doneIds, openTasks, type State } from "../lib/tracker";
import todo from "../../../docs/TO_IMPLEMENT.md?raw";
import implemented from "../../../docs/IMPLEMENTED.md?raw";

const repo = "https://github.com/octaviosantacruz/switchboard";
const release = `${repo}/releases/tag/v0.1.0-alpha.1`;
// Keep repository links hidden while GitHub reports the repository as private.
const sourcePublic = false;

// Roadmap and changelog come from docs/TO_IMPLEMENT.md and docs/IMPLEMENTED.md.
const open = openTasks(todo);
const done = doneIds(open, implemented);
const count = (s: State) => open.filter((t) => t.state === s).length;
const stats = [
  { n: done.size, label: "tasks done" },
  { n: count("progress"), label: "in progress" },
  { n: count("planned") + count("ready"), label: "planned" },
];
const board = rows(sample);

const works = [
  { t: "Routing by hostname", d: "Routes HTTP services by hostname, with health checks and one config for localhost or a real domain.", e: "Automated tests · Linux edge dogfooding" },
  { t: "Automatic HTTPS", d: "ACME TLS-ALPN-01 or Cloudflare DNS-01, with a single-level wildcard and background renewal.", e: "A production certificate on the author's server · the DNS adapter is Cloudflare-specific" },
  { t: "Login per route", d: "Signs people in with a passkey or an external OIDC provider, then checks their verified email and its domain.", e: "Automated tests · passkeys are on main, not in alpha.1" },
  { t: "Explainable decisions", d: "The same decision, with a stable code and a reason, in the CLI, the console and this page.", e: "Automated tests" },
  { t: "Static sites", d: "Immutable builds, a switch for the live one, rollback, and deploys from GitHub Actions with no stored secret.", e: "Observed on the author's server · single host" },
  { t: "A console for operators", d: "What needs attention, what changed and who got in, in plain words. Loopback-only: never expose it publicly.", e: "On main · recorded demo workspace" },
  { t: "Secrets by reference", d: "env: and file: references resolved at runtime; nothing resolved is written back.", e: "Automated tests · one binary, optional embedded SQLite" },
];

const pipeline = [
  { s: "trust", d: "Who is really asking: client IP, trusted proxies, origin certificate.", state: "built" },
  { s: "ratelimit", d: "Per visitor and per app limits.", state: "building" },
  { s: "shield", d: "Rules and challenges for suspicious traffic.", state: "planned" },
  { s: "identify", d: "Passkeys, or your OIDC provider.", state: "built" },
  { s: "authorize", d: "One pure decision with a code and a reason.", state: "built" },
  { s: "route", d: "Host lookup in an atomic snapshot.", state: "built" },
  { s: "forward", d: "HTTP upstream or a static site. Tunnels are experimental.", state: "built" },
] as const;
const stateWord = { built: "Built", building: "In progress", planned: "Planned" } as const;


const steps = [
  { short: "What needs you", t: "The operator sees what needs attention", d: "One thing is wrong: an app that does not answer. A live map shows every app behind the edge, with who got in and what changed below it.", img: "overview", w: 2560, h: 1600, alt: "The console Overview with an app that is not answering, recent changes and access decisions." },
  { short: "Invite Ana", t: "Inviting Ana", d: "The operator invites her by email. She gets a one-time link and creates a passkey on her own device. No password to share.", img: "people", w: 2560, h: 1600, alt: "The People page with an invitation form and the list of invited people." },
  { short: "Ana's apps", t: "Ana sees only her apps", d: "Grafana, Billing and the wiki. Nothing else is listed, and a sensitive app can ask her to sign in again.", img: "portal", w: 840, h: 1438, narrow: true, alt: "Ana's page lists the apps her account may open." },
  { short: "Bob is refused", t: "Bob, from another company, is refused", d: "He gets a clear answer with the reason and a way back to his own apps, not a bare error.", img: "refused", w: 840, h: 702, narrow: true, alt: "Bob's refusal page names the reason and links back to his apps." },
  { short: "The log", t: "The log explains both", d: "Every decision with its reason: why Ana got in and why Bob did not.", img: "access-log", w: 2560, h: 1600, alt: "The access log listing allowed and refused requests with their reasons." },
];
---
<Base title="Switchboard — your apps, your access rules" description="Control who can open your apps, with a reason for every decision. A self-hosted access gateway in one Go binary. Try the real policy engine in your browser.">
  <Header here="home" />

  <main id="main-content" tabindex="-1">
    <section class="hero frame" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Your apps.<br />Your access rules.</h1>
        <p class="hero-description">Control who can open your apps, with a reason for every decision. Self-hosted in one Go binary.</p>
        <div class="hero-actions">
          <a class="button button-brand" href="#engine">Try an access decision <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#how">See how it decides <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note">Early alpha. Running on the author's server.<br />The demo uses the same Go policy code as the gateway.</p>
      </div>
      <Engine />
    </section>

    <section id="how" class="section frame" aria-labelledby="how-title">
      <div class="section-intro">
        <h2 id="how-title">One place decides.</h2>
        <p>Every request to your apps passes through Switchboard first. It checks who is asking, decides with your rules, and either lets them through, asks them to sign in, or refuses with a reason.</p>
      </div>
      <EdgeMap />
      <div class="how">
        <div>
          <h3 class="sub-title">The same order, every request.</h3>
          <ol class="pipeline-strip">{pipeline.map((p) => <li><strong>{p.s}</strong><p>{p.d}</p><span class={`small pipeline-state ${p.state}`}>{stateWord[p.state]}</span></li>)}</ol>
        </div>
        <div class="terminal" data-ui><pre><code>$ switchboard policy explain \
    -host grafana.acme.dev \
    -email bob@other.org -verified

route     grafana.acme.dev (protected)
policy    allowed_domains=[acme.dev]
decision  denied
code      domain_not_allowed
reason    account's email domain
          is not on the allowed list</code></pre><p class="small quiet">Any decision can be traced from the CLI, the console's log or the live demo, with the same code.</p></div>
      </div>
    </section>

    <section id="tour" class="section frame" aria-labelledby="tour-title">
      <div class="section-intro">
        <h2 id="tour-title">See it work.</h2>
        <p>One story in five screens: an invitation, an allowed visit, a refusal and the log that explains both. Real screens from a demo workspace.</p>
      </div>
      <div class="walk">
        <fieldset class="walk-tabs">
          <legend class="sr-only">Choose a step</legend>
          {steps.map((st, i) => <label><input type="radio" name="walk" id={`walk-${i + 1}`} checked={i === 0} /><span><b>{i + 1}</b>{st.short}</span></label>)}
        </fieldset>
        {steps.map((st, i) => (
          <article class="step" id={`step-${i + 1}`}>
            <div class="step-copy"><h3>{st.t}</h3><p>{st.d}</p>{i < steps.length - 1 && <label class="walk-next" for={`walk-${i + 2}`}>Next: {steps[i + 1].short} <span aria-hidden="true">→</span></label>}</div>
            <figure class={`step-shot ${st.narrow ? "step-narrow" : ""}`}><img src={`/shots/${st.img}.jpg`} width={st.w} height={st.h} loading={i === 0 ? "eager" : "lazy"} alt={st.alt} /></figure>
          </article>
        ))}
      </div>
      <details class="disclosure tour-log">
        <summary>Read the access decisions from this story</summary>
        <div class="disclosure-body">
          <p class="quiet small">Recorded demo data. Open a row for the reason.</p>
          <div class="rows" data-ui>{board.map((r) => (
            <details class="row" name="log">
              <summary><span class="request-person">{r.who}<small>{r.app}</small></span><span class={`status ${r.ok ? "status-ok" : "status-no"}`}>{r.status}</span></summary>
              <p class="detail">{r.detail}</p>
            </details>
          ))}</div>
        </div>
      </details>
    </section>

    <section id="today" class="section frame" aria-labelledby="today-title">
      <div class="section-intro"><h2 id="today-title">What works today.</h2><p>Automated tests and limited use by one operator. The evidence and release boundaries are stated with each capability.</p></div>
      <div class="capabilities">{works.map((w) => (
        <article><h3>{w.t}</h3><p>{w.d}</p><p class="small quiet">{w.e}</p></article>
      ))}</div>
      <p class="scope-note"><strong>Still experimental.</strong> Outbound tunnels, rate limiting and Telegram alerts exist in the code and sit outside the alpha's promise. Account recovery requires the operator's local CLI.</p>
    </section>

    <section id="roadmap" class="section frame" aria-labelledby="roadmap-title">
      <div class="section-intro"><h2 id="roadmap-title">Where it goes next.</h2><p>A year-long project, October 2026 to September 2027. The full roadmap, module by module, is read from the project's trackers.</p></div>
      <dl class="progress-counts">{stats.map((s) => <div><dt>{s.label}</dt><dd>{s.n}</dd></div>)}</dl>
      <ol class="release-plan">{trains.map((t) => <li class={t.now ? "current" : ""}><h3>{t.v} · {t.n}</h3><p class="small quiet">{t.now ? "Current · " : "Planned · "}{t.when}</p><p>{t.line}</p></li>)}</ol>
      <p class="roadmap-note"><a class="text-link" href="/roadmap/">Read the full roadmap and changelog <span aria-hidden="true">→</span></a></p>
    </section>

    <section id="start" class="availability frame section" aria-labelledby="start-title">
      <div><h2 id="start-title">Explore the alpha.</h2><p>{sourcePublic ? "Downloads for Linux, macOS and Windows, with a quickstart to route your first app." : "The repository and alpha downloads are currently private. You can try the policy engine here, walk through the five screens or visit the maintainer's site to get in touch."}</p></div>
      <div class="availability-actions">{sourcePublic ? <a class="button button-brand" href={release}>Download alpha.1 <span aria-hidden="true">↗</span></a> : <a class="button button-brand" href="https://octaviosantacruz.com">Visit the maintainer's site <span aria-hidden="true">↗</span></a>}<a class="text-link" href="#engine">Back to the live demo ↑</a></div>
    </section>
  </main>
  <Footer />
</Base>
<script>import "../scripts/page";</script>
