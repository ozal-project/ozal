---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { trains } from "../data/trains";
import Engine from "../components/Engine.astro";
import EdgeMap from "../components/EdgeMap.astro";
import Logo from "../components/Logo.astro";

const repo = "https://github.com/ozal-project/ozal";
// The Ozal repository is public; Ozal release artifacts are not published yet.
const sourcePublic = true;


// "In use" runs on the author's server; "Tested" is covered by automated
// tests only; "Unreleased" is on main but not in alpha.1.
const works = [
  { t: "Routing by hostname", d: "Any HTTP app, with health checks.", e: "In use" },
  { t: "Automatic HTTPS", d: "Certificates issued and renewed for you.", e: "In use" },
  { t: "Sign-in per app", d: "Passkeys or your OIDC provider.", e: "Tested" },
  { t: "Explainable decisions", d: "A code and a reason for every answer.", e: "Tested" },
  { t: "Static sites", d: "Deploys from GitHub Actions, one-step rollback.", e: "In use" },
  { t: "Domains", d: "One certificate per domain, renewed on its own.", e: "Unreleased" },
  { t: "Operator console", d: "Who got in and what changed, in plain words.", e: "Unreleased" },
];

const pipeline = [
  { s: "trust", d: "Who is really asking: client IP, trusted proxies, origin certificate.", state: "built" },
  { s: "ratelimit", d: "Per visitor and per app limits.", state: "building" },
  { s: "shield", d: "Rules and challenges for suspicious traffic.", state: "planned" },
  { s: "identify", d: "Passkeys, or your OIDC provider.", state: "built" },
  { s: "authorize", d: "One pure decision with a code and a reason.", state: "built" },
  { s: "route", d: "Host lookup in an atomic snapshot.", state: "built" },
  { s: "forward", d: "HTTP upstream or a static site. Tunnels are experimental.", state: "built" },
] as const;
// How far through the year of releases the page was built.
const elapsed = Math.min(1, Math.max(0, (Date.now() - Date.UTC(2026, 9, 1)) / (Date.UTC(2027, 9, 1) - Date.UTC(2026, 9, 1)))).toFixed(3);
const stateWord = { built: "Built", building: "In progress", planned: "Planned" } as const;

// The console's "How private access works", word for word.
const flow = [
  { t: "A visitor opens", d: "grafana.acme.dev", mono: true },
  { t: "Ozal asks them to sign in", d: "With a passkey: fingerprint, face or PIN. No passwords." },
  { t: "Ozal checks your rule", d: "Only the people you choose get through. Others see a “no access” page." },
  { t: "Your app receives them", d: "Already signed in, with their email. The app needs no login of its own." },
];

// A Domains page as the console shows it (demo data): one card per domain,
// its certificate, and the one DNS record a new domain needs.
const zones = [
  { name: "acme.dev", state: "Active", lamp: "ok", cert: "Valid until Jan 28, 2027 · 89 days", renew: "Dec 29, 2026", apps: "3 · grafana.acme.dev, wiki.acme.dev…" },
  { name: "acme.io", state: "Waiting to issue", lamp: "wait", cert: "Not issued yet", renew: "After the first certificate", apps: "1 · status.acme.io",
    record: { type: "CNAME", name: "_acme-challenge.acme.io", value: "acme.io.edge.acme.dev" } },
];


const steps = [
  { short: "What needs you", t: "The operator sees what needs attention", d: "One thing is wrong: an app that does not answer. A live map shows every app behind the edge, with who got in and what changed below it.", img: "overview", w: 2560, h: 1600, alt: "The console Overview with an app that is not answering, recent changes and access decisions." },
  { short: "Invite Ana", t: "Inviting Ana", d: "The operator invites her by email. She gets a one-time link and creates a passkey on her own device. No password to share.", img: "people", w: 2560, h: 1600, alt: "The People page with an invitation form and the list of invited people." },
  { short: "Ana's apps", t: "Ana sees only her apps", d: "Grafana, Billing and the wiki. Nothing else is listed, and a sensitive app can ask her to sign in again.", img: "portal", w: 840, h: 1438, narrow: true, alt: "Ana's page lists the apps her account may open." },
  { short: "Bob is refused", t: "Bob, from another company, is refused", d: "He gets a clear answer with the reason and a way back to his own apps, not a bare error.", img: "refused", w: 840, h: 702, narrow: true, alt: "Bob's refusal page names the reason and links back to his apps." },
  { short: "The log", t: "The log explains both", d: "Every decision with its reason: why Ana got in and why Bob did not.", img: "access-log", w: 2560, h: 1600, alt: "The access log listing allowed and refused requests with their reasons." },
];
---
<Base title="Ozal — the front door for your self-hosted apps" description="Put your internal apps on the internet without a VPN. Ozal signs people in, checks your rules and only then lets them reach the app. Self-hosted, one Go binary.">
  <Header here="home" />

  <main id="main-content" tabindex="-1">
    <section class="hero frame" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-mark"><Logo size={52} entrance id="logo-hero" /><span>Open source · early alpha</span></p>
        <h1 id="hero-title">The front door for your self&#8209;hosted apps.</h1>
        <p class="hero-description">Put Grafana, a wiki or any internal tool on the internet. Ozal signs people in, checks your rules, and only then lets them reach the app. No VPN, one Go binary.</p>
        <div class="hero-actions">
          <a class="button button-brand" href="#how">See how it works <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#engine">Try an access decision <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note">Early alpha, running on the author's server. If you know Cloudflare Access or Pomerium: the same idea, on a server you own.</p>
      </div>
      <dl class="compare" aria-label="Before and after Ozal">
        <div class="compare-before">
          <dt>Without it</dt>
          <dd><code>grafana.yourdomain.com</code> answers anyone who finds it. Every app has its own login, or none.</dd>
        </div>
        <div class="compare-after">
          <dt>With Ozal</dt>
          <dd>People sign in once, with a passkey or the login you already use (Google, Microsoft, any OIDC provider).</dd>
          <dd>Your rules decide: "only <code>@acme.dev</code> emails open Grafana", "only Ana opens Billing".</dd>
          <dd>Every attempt is logged with its reason, so you can see who got in and why someone did not.</dd>
        </div>
      </dl>
    </section>

    <section id="how" class="section frame" aria-labelledby="how-title">
      <div class="section-intro">
        <h2 id="how-title">Everyone goes through one door.</h2>
        <p>Your apps stop facing the internet directly. Every request reaches Ozal first, which checks who is asking and either lets them through, asks them to sign in, or refuses with a reason. The apps themselves do not change.</p>
      </div>
      <EdgeMap />
      <div class="how">
        <div>
          <h3 class="sub-title">The same order, every request.</h3>
          <ol class="pipeline-strip">{pipeline.map((p) => <li><strong>{p.s}</strong><p>{p.d}</p><span class={`small pipeline-state ${p.state}`}>{stateWord[p.state]}</span></li>)}</ol>
        </div>
        <div class="terminal" data-ui><pre><code>$ ozal policy explain \
    -host grafana.acme.dev \
    -email bob@other.org -verified

route     grafana.acme.dev (protected)
policy    allowed_domains=[acme.dev]
decision  denied
code      domain_not_allowed
reason    account's email domain
          is not on the allowed list</code></pre><p class="small quiet">Any decision can be traced from the CLI, the console's log or the live demo, with the same code.</p></div>
      </div>
    </section>

    <section id="private" class="section frame" aria-labelledby="private-title">
      <div class="section-intro">
        <h2 id="private-title">Make an app private in four steps.</h2>
        <p>Pick the people or groups who may open it. Ozal puts a sign-in in front of the app; the app itself does not change and needs no login of its own.</p>
      </div>
      <ol class="flow">{flow.map((s, i) => (
        <li><span class="flow-n" aria-hidden="true">{i + 1}</span><h3>{s.t}</h3><p class:list={[s.mono && "flow-mono"]}>{s.d}</p></li>
      ))}</ol>
      <div class="receives">
        <div>
          <h3 class="sub-title">What your app receives.</h3>
          <p class="soft">Every request that reaches the app carries the signed-in person. Ozal removes these headers from what visitors send, so they cannot be faked, and never forwards its session cookie.</p>
          <p class="quiet small">An app with its own login keeps it: Ozal decides who reaches the app, not what they can do inside.</p>
        </div>
        <div class="terminal" data-ui><pre><code>GET /dashboard HTTP/1.1
Host: grafana.acme.dev
X-Auth-Request-Email: ana@acme.dev
X-Auth-Request-User: sb:7f3c…e21a</code></pre><p class="small quiet">Use them to show who is signed in or to link records to a person.</p></div>
      </div>
    </section>

    <section id="domains" class="section frame" aria-labelledby="domains-title">
      <div class="section-intro">
        <h2 id="domains-title">Your domains, one certificate each.</h2>
        <p>Add a domain once and every address under it gets HTTPS. Each domain has its own certificate and renews on its own schedule, so one failing renewal never takes the others down. A new domain needs a single DNS record, and Ozal never asks for access to your DNS account.</p>
      </div>
      <div class="window zone-window" data-ui>
        <span class="window-bar" aria-hidden="true"><i></i><i></i><i></i><b>Operator console · Domains · demo workspace</b></span>
        <ul class="zones" aria-label="Example domains">{zones.map((z) => (
          <li class="zone-card">
            <div class="zone-head">
              <div><h3>{z.name}</h3><p class="quiet small">Covers {z.name} and every address like <code>app.{z.name}</code></p></div>
              <span class="zone-state"><span class={`lamp lamp-${z.lamp}`} aria-hidden="true"></span>{z.state}</span>
            </div>
            <dl class="zone-facts">
              <div><dt>Certificate</dt><dd>{z.cert}</dd></div>
              <div><dt>Next renewal</dt><dd>{z.renew}</dd></div>
              <div><dt>Applications</dt><dd>{z.apps}</dd></div>
            </dl>
            {z.record && (
              <div class="zone-record">
                <p class="small soft">Create this DNS record at your DNS provider. It lets Ozal prove it controls {z.name} for every renewal.</p>
                <dl class="dns-record">
                  <div><dt>Type</dt><dd><code>{z.record.type}</code></dd></div>
                  <div><dt>Name</dt><dd><code>{z.record.name}</code></dd></div>
                  <div><dt>Value</dt><dd><code>{z.record.value}</code></dd></div>
                </dl>
              </div>
            )}
          </li>
        ))}</ul>
      </div>
      <p class="scope-note small quiet">Ozal checks the record before it asks the certificate authority, and keeps serving the current certificate while a renewal runs.</p>
    </section>

    <section class="try section frame" aria-labelledby="try-title">
      <div class="section-intro">
        <h2 id="try-title">Ask it a question.</h2>
        <p>Pick an app and a person. The answer comes from the real access decision, the same Go code as the gateway, compiled to WebAssembly and running in your browser. Nothing is sent anywhere.</p>
      </div>
      <Engine />
    </section>

    <section id="tour" class="section frame" aria-labelledby="tour-title">
      <div class="section-intro">
        <h2 id="tour-title">See it work.</h2>
        <p>One story in five screens: an invitation, an allowed visit, a refusal and the log that explains both. Real screens from a demo workspace.</p>
      </div>
      <div class="walk">
        <fieldset class="walk-tabs">
          <legend class="sr-only">Choose a step</legend>
          {steps.map((st, i) => <label><input type="radio" name="walk" id={`walk-${i + 1}`} checked={i === 0} /><span><b>{i + 1}</b>{st.short}</span></label>)}
        </fieldset>
        {steps.map((st, i) => (
          <article class="step" id={`step-${i + 1}`}>
            <div class="step-copy"><h3>{st.t}</h3><p>{st.d}</p>{i < steps.length - 1 && <label class="walk-next" for={`walk-${i + 2}`}>Next: {steps[i + 1].short} <span aria-hidden="true">→</span></label>}</div>
            <figure class={`step-shot ${st.narrow ? "step-narrow" : ""}`}>
              <div class="window"><span class="window-bar" aria-hidden="true"><i></i><i></i><i></i><b>{st.narrow ? "Ana's browser" : "Operator console"} · demo workspace</b></span><a href={`/shots/${st.img}.jpg`} aria-label={`Open full size: ${st.alt}`}><img src={`/shots/${st.img}.jpg`} width={st.w} height={st.h} loading={i === 0 ? "eager" : "lazy"} alt={st.alt} /></a></div>
              <figcaption><a class="text-link" href={`/shots/${st.img}.jpg`}>Open full size <span aria-hidden="true">↗</span></a></figcaption>
            </figure>
          </article>
        ))}
      </div>
    </section>

    <section id="today" class="section frame" aria-labelledby="today-title">
      <div class="section-intro"><h2 id="today-title">What works today.</h2><p>An early alpha, used every day by one operator. Each feature says how far it has been proven.</p></div>
      <ul class="works">{works.map((w) => (
        <li class={`works-${w.e.toLowerCase().replace(" ", "-")}`}><span class="works-tag">{w.e}</span><h3>{w.t}</h3><p>{w.d}</p></li>
      ))}<li class="works-next"><span class="works-tag">Experimental</span><h3>Outside the alpha</h3><p>Tunnels, rate limiting and Telegram alerts.</p></li></ul>
      <dl class="works-legend small quiet" aria-label="What the tags mean">
        <div><dt class="works-tag works-in-use">In use</dt><dd>runs on the author's server</dd></div>
        <div><dt class="works-tag">Tested</dt><dd>covered by automated tests</dd></div>
        <div><dt class="works-tag works-unreleased">Unreleased</dt><dd>on main, not in alpha.1</dd></div>
      </dl>
    </section>

    <section id="roadmap" class="section frame" aria-labelledby="roadmap-title">
      <div class="section-intro"><h2 id="roadmap-title">Where it goes next.</h2><p>Four releases in a year, October 2026 to September 2027. Each one builds on the door the previous one opened.</p></div>
      <div class="rail" style={`--done: ${elapsed}`} aria-hidden="true"><span class="rail-fill"></span><span class="rail-now"></span></div>
      <ol class="timeline">{trains.map((t) => (
        <li class={t.now ? "current" : ""} aria-current={t.now ? "step" : undefined}>
          <p class="timeline-when small">{t.now ? "Now · " : ""}{t.when}</p>
          <h3><span class="timeline-v">{t.v}</span> {t.n}</h3>
          <p>{t.line}</p>
          <ul class="timeline-items">{t.items.map((item) => <li>{item}</li>)}</ul>
        </li>
      ))}</ol>
    </section>

    <section id="start" class="availability frame section" aria-labelledby="start-title">
      <div><h2 id="start-title">Explore the alpha.</h2><p>{sourcePublic ? "Explore the source and quickstart. Ozal release downloads are not published yet." : "The code and downloads are private for now."}</p></div>
      <div class="availability-actions">{sourcePublic ? <a class="button button-brand" href={repo}>Source on GitHub <span aria-hidden="true">↗</span></a> : <a class="button button-brand" href="https://octaviosantacruz.com">Visit the maintainer's site <span aria-hidden="true">↗</span></a>}<a class="text-link" href="#how">Back to how it works ↑</a></div>
    </section>
  </main>
  <Footer />
</Base>
<script>import "../scripts/page";</script>
