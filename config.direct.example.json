{
  "listen": ":8888",
  "runtime_file": "/var/lib/switchboard/runtime.json",
  "admin": {
    "listen": "127.0.0.1:9090",
    "socket": "/run/switchboard/admin.sock"
  },
  "tls": {
    "enabled": true,
    "domains": ["auth.example.com"],
    "cache_dir": "/var/lib/switchboard/acme",
    "email": "operator@example.com"
  },
  "dns": { "target": "edge.example.com" },
  "auth": {
    "cookie_domain": "example.com",
    "passkeys": {
      "rp_id": "example.com",
      "login_url": "https://auth.example.com",
      "display_name": "Switchboard"
    }
  },
  "routes": [
    {
      "host": "notes.example.com",
      "target": "http://127.0.0.1:3000",
      "access": { "allowed_emails": ["operator@example.com"] }
    },
    {
      "host": "wiki.example.org",
      "target": "http://127.0.0.1:3001",
      "access": { "allowed_emails": ["operator@example.com"] }
    }
  ]
}
