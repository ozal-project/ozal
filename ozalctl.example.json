{
  "targets": {
    "edge-1": {
      "ssh": { "target": "deploy@edge.example.net", "key": "~/.ssh/id_ed25519" },
      "edge": {
        "unit": "ozal",
        "service_user": "ozal",
        "service_group": "ozal",
        "binary": "/usr/local/lib/ozal/ozal",
        "config": "/etc/ozal/config.json",
        "state_db": "/var/lib/ozal/state.db",
        "stage": "/home/deploy/.local/share/ozal-stage",
        "lock": "/home/deploy/.local/share/ozal-deploy.lock",
        "command_link": "/usr/local/bin/ozal",
        "socket": "/run/ozal/admin.sock",
        "socket_group": "ozal-admin",
        "admin": "127.0.0.1:9090",
        "sites_token": "~/.config/ozalctl/edge-1.sites.token",
        "keep": 3
      },
      "connector": {
        "ssh": { "target": "ozal@connector.example.net", "key": "~/.ssh/id_ed25519" },
        "name": "portfolio",
        "unit": "ozal-tunnel-connector.service",
        "service_user": "ozal",
        "binary": "/home/ozal/.local/bin/ozal",
        "stage": "/home/ozal/.local/share/ozal-stage",
        "lock": "/home/ozal/.local/share/ozal-deploy.lock"
      }
    }
  }
}
