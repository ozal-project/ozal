{
  "name": "ozal-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Ozal admin console. Build-time only: the output is embedded in the Go binary.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "react:dev": "vite --config vite.react.config.ts",
    "react:build": "vite build --config vite.react.config.ts",
    "react:preview": "vite preview --config vite.react.config.ts",
    "react:check": "npm run check"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  }
