{
  "name": "ozal-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Ozal admin console. Build-time only: the output is embedded in the Go binary.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "react:dev": "vite --config vite.react.config.ts",
    "react:build": "vite build --config vite.react.config.ts",
    "react:preview": "vite preview --config vite.react.config.ts",
    "react:check": "tsc --noEmit -p tsconfig.react.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
